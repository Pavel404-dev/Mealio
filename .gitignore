# ============================================================
# Mealio .gitignore
# ============================================================

# ------------------------------------------------------------
# Environment files
# ------------------------------------------------------------
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local

# Keep example env files in Git
!.env.example
!backend/.env.example

# ------------------------------------------------------------
# Python / FastAPI
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/
backend/ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

*.db
*.sqlite3

# ------------------------------------------------------------
# Node.js
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Flutter / Dart / Pub
# ------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.packages.generated
.pub/
.pub-cache/
.pub-preload-cache/
build/

**/doc/api/
**/generated_plugin_registrant.dart

flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# ------------------------------------------------------------
# Android
# ------------------------------------------------------------
.gradle/
**/android/**/gradle-wrapper.jar
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks

